# Copy to .env.local only if it does not already exist. Preserve valid values.
# Obtain these values from YOUR approved Firebase project's Web app settings.
# The web API key identifies the project; authorization uses verified identity,
# Admin IAM and security rules. No NEXT_PUBLIC values are required in this phase.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=
APP_URL=http://localhost:3000

# Local Admin credentials ONLY: use a private service-account JSON file kept
# OUTSIDE this repository, or approved ADC impersonation. Never commit the file.
# Leave this unset on App Hosting: use the runtime service identity instead.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-admin.json
